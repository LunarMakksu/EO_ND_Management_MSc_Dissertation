akeSetDataModule\n","from torchgeo.models import ResNet50_Weights, resnet50\n","from google.colab import drive\n","drive.mount('/content/drive') # for saving model\n","folder_models = ('/content/drive/My Drive/Dissertation/models/')\n","model_name = \"MagNet_despeckled_split_input.keras\" #\"MagNet_both_labels.keras\"\n","\n","num_workers = 2 # was 1\n","batch_size = 4 #was 4\n","LOAD_MODEL = True # False: if you just trained it | True: load a pretrained one from drive\n","REMOVE_UNAFFECTED = True\n","if REMOVE_UNAFFECTED:\n","  PCT_SAMPLES = 0.3\n","else:\n","  PCT_SAMPLES = 0.1 # PCT dataset to use, if using both labels, use 0.1\n","\n","tmp_path = Path(tempfile.gettempdir()) / 'earthquake'\n","\n","# Remove the directory if it exists to ensure a fresh download\n","if tmp_path.exists():\n","    shutil.rmtree(tmp_path)\n","\n","datamodule = QuakeSetDataModule(\n","    batch_size=batch_size, num_workers=num_workers, download=True, root=tmp_path\n",")\n","datamodule.prepare_data() #downloads it\n","print(\"Data module downloaded\")\n","datamodule.setup('fit')\n","datamodule.setup('validate')\n","datamodule.setup('test')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VOZZYDsxhMmY","executionInfo":{"status":"ok","timestamp":1780999088355,"user_tz":-60,"elapsed":108998,"user":{"displayName":"Max","userId":"13369729728812710385"}},"outputId":"c38d4ddf-0a3c-46ed-9aa9-b6ba6e837146"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Data module downloaded\n"]}]},{"cell_type":"code","source":["datamodule.train_dataset.data = datamodule.train_dataset.data[\n","    : int(len(datamodule.train_dataset.data) * PCT_SAMPLES)\n","]\n","\n","datamodule.val_dataset.data = datamodule.val_dataset.data[\n","    : int(len(datamodule.val_dataset.data) * PCT_SAMPLES)\n","]\n","\n","datamodule.test_dataset.data = datamodule.test_dataset.data[\n","    : int(len(datamodule.test_dataset.data) * PCT_SAMPLES)\n","]\n","# be careful not to rerun this as it will shrink the datasets"],"metadata":{"id":"_1lcJqJaP9JE"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Remove images with a False affected label\n","if REMOVE_UNAFFECTED:\n","  datamodule.train_dataset.data = [sample for sample in datamodule.train_dataset.data if int(sample['label']) == 1]\n","  datamodule.val_dataset.data = [sample for sample in datamodule.val_dataset.data if int(sample['label']) == 1]\n","  datamodule.test_dataset.data = [sample for sample in datamodule.test_dataset.data if int(sample['label']) == 1]"],"metadata":{"id":"3VCipu8bn7ia"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# PREPROCESSING\n","# Speckle filter?\n","# SAR-specific augmentation techniques\n","# Apparently for mag regression, flips, crops, and rotations are safe\n","\n","# Lee filter test\n","import matplotlib.pyplot as plt\n","def plot_dual_pol_sar(sar_tensor): # from gemini\n","    # 1. Convert to numpy if it's a PyTorch tensor\n","    if isinstance(sar_tensor, torch.Tensor):\n","        sar = sar_tensor.detach().cpu().numpy()\n","    else:\n","        sar = sar_tensor\n","\n","    # Ensure it's in (H, W, C) or handle (C, H, W)\n","    if sar.shape[0] == 2:\n","        vv = sar[0, :, :]\n","        vh = sar[1, :, :]\n","    else:\n","        vv = sar[:, :, 0]\n","        vh = sar[:, :, 1]\n","\n","    # 2. Convert raw amplitude/intensity to Decibels (dB)\n","    # Adding a tiny epsilon to avoid log(0)\n","    eps = 1e-6\n","    vv_db = 10 * np.log10(np.abs(vv) + eps)\n","    vh_db = 10 * np.log10(np.abs(vh) + eps)\n","    ratio_db = vv_db - vh_db # Division in linear scale becomes subtraction in dB\n","\n","    # 3. Clip and Normalize each channel to [0, 1]\n","    # SAR backscatter typically falls within specific ranges (e.g., -25 dB to 0 dB)\n","    def normalize(channel, vmin, vmax):\n","        channel = np.clip(channel, vmin, vmax)\n","        return (channel - vmin) / (vmax - vmin)\n","\n","    # Dynamic ranges vary, but these are solid baseline estimates for Sentinel-1:\n","    r = normalize(vv_db, vmin=-25, vmax=0)\n","    g = normalize(vh_db, vmin=-30, vmax=-5)\n","    b = normalize(ratio_db, vmin=0, vmax=15)\n","\n","    # 4. Stack into an RGB image layout (H, W, 3)\n","    rgb_image = np.stack([r, g, b], axis=-1)\n","\n","    # 5. Plot it\n","    plt.figure(figsize=(8, 8))\n","    plt.imshow(rgb_image)\n","    plt.title(\"SAR Pseudo-RGB (R:VV, G:VH, B:VV/VH)\")\n","    plt.axis('off')\n","    plt.show()\n","\n","\n","from scipy.ndimage import uniform_filter\n","def LeeFilter(img_tensor, window_size: int = 5):\n","  \"\"\"Adapted from https://medium.com/@abhishekjainindore24/speckle-noise-and-ways-to-remove-it-01b1b15d074a\"\"\"\n","  img = img_tensor.numpy()\n","  # input is (4, 512, 512)\n","  size = (1, window_size, window_size)\n","  img_mean = uniform_filter(img, size)\n","  img_sqr_mean = uniform_filter(img**2, size)\n","  img_variance = img_sqr_mean - img_mean**2\n","\n","  overall_variance = np.var(img, axis=(1, 2), keepdims=True) # unsure about axis\n","\n","  img_weights = img_variance / (img_variance + overall_variance + 1e-8) # in case of div by 0\n","  img_output = img_mean + img_weights * (img - img_mean)\n","  return torch.from_numpy(img_output)\n","\n","\n","sample = datamodule.train_dataset[0].copy()\n","plot_dual_pol_sar(sample['image'][:2, :, :])\n","sample['image'] = LeeFilter(sample['image'])\n","plot_dual_pol_sar(sample['image'][:2, :, :]) #seems to dull it\n","\n"],"metadata":{"id":"8wAXEjwfhWNu"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["X_Train = [sample['image'] for sample in datamodule.train_dataset] # dont filter in here or youll run out of RAM\n","Y_Train_mag = [sample['magnitude'] for sample in datamodule.train_dataset]\n","X_Val = [sample['image'] for sample in datamodule.val_dataset]\n","Y_Val = [sample['magnitude'] for sample in datamodule.val_dataset]\n","X_Test = [sample['image'] for sample in datamodule.test_dataset]\n","Y_Test = [sample['magnitude'] for sample in datamodule.test_dataset]\n","\n","# Lee filter\n","X_Train_filtered = [LeeFilter(sample) for sample in X_Train]\n","X_Val_filtered = [LeeFilter(sample) for sample in X_Val]\n","\n","# Releasing memory\n","X_Train = None\n","X_Val = None\n","\n","def transposeQuakeSetSamples(samples):\n","  # Convert lists of PyTorch tensors to single NumPy arrays (NCHW format)\n","  samples_np = torch.stack(samples).numpy()\n","  # Transpose the input data from NCHW (Batch, Channels, Height, Width)\n","  # to NHWC (Batch, Height, Width, Channels) to match TensorFlow's preference.\n","  samples_np = samples_np.transpose(0, 2, 3, 1)\n","  return samples_np\n","\n","X_Train_np = transposeQuakeSetSamples(X_Train_filtered)\n","X_Val_np = transposeQuakeSetSamples(X_Val_filtered)\n","X_Test_np = transposeQuakeSetSamples(X_Test)\n","Y_Train_np = torch.stack(Y_Train).numpy() # need to be stacked as they are used in the model fitting\n","Y_Val_np = torch.stack(Y_Val).numpy()\n","\n","# Releasing more memory\n","Y_Train = None\n","Y_Val = None\n","X_Test = None\n","# Maybe get rid of datamodule?"],"metadata":{"id":"G04jmuumE7Qx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Custom network approach\n","from keras.models import Model, Sequential\n","from keras.layers import Input, Flatten, Dense, Conv2D, MaxPool2D, BatchNormalization, Dropout, Concatenate, Lambda # augmentation functions\n","import torch # Ensure torch is imported if DEVICE relies on it\n","DEVICE = \"cuda\" if torch.cuda.is_available() else 'cpu'\n","\n","# [VV_pre, VH_pre, VV_post, VH_post]\n","input_shape = (512, 512, 4) # shape is (4, 512, 512) but it will have been be transposed\n","\n","main_input = Input(shape=input_shape, name=\"input\")\n","\n","# Split into pre and post images\n","pre_event_input = main_input[:, :, :, :2] #Lambda(lambda x: x[:, :, :, :2], output_shape=(512, 512, 2))(main_input)\n","post_event_input = main_input[:, :, :, 2:] #Lambda(lambda x: x[:, :, :, 2:], output_shape=(512, 512, 2))(main_input)\n","\n","# Feature extraction from pre event image - need emphasis on either?\n","pre_event = Conv2D(32, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event_input)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","pre_event = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","pre_event = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","\n","# Feature extraction from post event image\n","post_event = Conv2D(32, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event_input)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","post_event = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","post_event = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","\n","# how to concatenate if the branches have different size outputs?\n","combined = Concatenate(axis=-1)([pre_event, post_event]) # on channel axis, could have different outputs, include affected label?\n","\n","# Learning shared features\n","x = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(combined)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x) # this one was removed for better performance\n","x = Dropout(0.2)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(x)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x) # this one was removed for better performance\n","x = Dropout(0.2)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Conv2D(256, kernel_size=(3, 3), activation='relu', padding=\"same\")(x)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x)\n","x = Dropout(0.4)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Flatten()(x)\n","mag_output = Dense(1, activation='linear', name=\"magnitude_output\")(x)\n","\n","model = Model(inputs=main_input, outputs=mag_output)\n","\n","model.summary()\n","from keras.utils import plot_model\n","try:\n","  plot_model(model, show_shapes=True, dpi=100)\n","except AssertionError as e:\n","  print(\"I think the input tensor split causes model plotting problems here\")"],"metadata":{"id":"lKbVmtDE-_qd"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from keras.optimizers import Adam\n","from keras.callbacks import EarlyStopping, ReduceLROnPlateau\n","\n","es_callback = EarlyStopping(monitor='val_loss',\n","                            # min_delta = 0.001,\n","                            patience=6,\n","                            restore_best_weights=True)\n","\n","lr_scheduler = ReduceLROnPlateau(monitor='val_loss',\n","                                 factor=0.7, #was 0.5\n","                                 patience=3,\n","                                 min_lr=1e-6)\n","\n","if not LOAD_MODEL:\n","  init_learning_rate = 1e-4 # was 1e-4\n","  model.compile(\n","      optimizer=Adam(learning_rate=init_learning_rate),\n","      loss='mse',\n","      metrics=['mae'],\n","  )\n","\n","  EPOCHS = 20\n","\n","  history = model.fit(\n","      x=X_Train_np, # this has been despeckled now\n","      y=Y_Train_np,\n","      validation_data=[X_Val_np, Y_Val_np],\n","      batch_size=32,\n","      callbacks=[es_callback, lr_scheduler],\n","      epochs=EPOCHS\n","  )\n","\n","  model.save(folder_models+model_name)\n","  print(\"Modelled saved to: \", folder_models+model_name)"],"metadata":{"id":"Oah-CtBRls_5"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["if LOAD_MODEL:\n","  from keras.saving import load_model\n","  model = load_model(folder_models+model_name)\n","\n","# Pruning and quantization"],"metadata":{"id":"t7PyGYD-hOWD"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import random\n","print(\"Single sample\")\n","sample = datamodule.test_dataset[random.randint(0, len(datamodule.test_dataset))]\n","datamodule.plot(sample)\n","\n","def processSingleSample(sample): # NOT LeeFiltered\n","  sample_img = sample['image'] #LeeFilter(sample['image'])\n","  sample_y = sample['magnitude']\n","  sample_img = sample_img.permute(1, 2, 0) #channel last\n","  sample_img = sample_img.unsqueeze(0) # add batch dim., it just works, think its batch dim: 1\n","  return sample_img, sample_y\n","\n","sample_img, sample_y = processSingleSample(sample)\n","\n","y_hat = model.predict(sample_img, verbose=0).item() #extract from nested np array\n","print(f\"Predicted magnitude: {y_hat:.2f}. Actual magnitude: {sample_y:.2f}. Abs Error: {abs(y_hat - sample_y):.2f}\")\n","print(\"\")\n","\n","print(\"All testing samples:\")\n","# BARE IN MIND: The testing set is not despeckled\n","mae = 0.0\n","N = len(datamodule.test_dataset.data)\n","for sample, y in tqdm(zip(X_Test_np, Y_Test), desc='Test'):\n","  # sample = LeeFilter(torch.from_numpy(sample))\n","  sample_batched = np.expand_dims(sample, axis=0) #add batch dim\n","  y_hat = model.predict(sample_batched, verbose=0).item()\n","  error = abs(y.item() - y_hat)\n","  mae += error\n","print(\"\")\n","print(f\"MAE after {N} testing samples : {round(mae/N, 3)}\")"],"metadata":{"id":"SnpPXiucYIVw"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Notes from testing:\n","\n","- Model training soley on affected images has high AE when testing on unaffected data (MAE 2.9)"],"metadata":{"id":"usg_de9XoYnm"}}]}