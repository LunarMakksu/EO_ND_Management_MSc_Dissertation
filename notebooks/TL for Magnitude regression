pfile.gettempdir()) / 'earthquake'\n","\n","# Remove the directory if it exists to ensure a fresh download\n","if tmp_path.exists():\n","    shutil.rmtree(tmp_path)\n","\n","datamodule = QuakeSetDataModule(\n","    batch_size=batch_size, num_workers=num_workers, download=True, root=tmp_path\n",")\n","datamodule.prepare_data() #downloads it\n","print(\"Data module downloaded\")\n","datamodule.setup('fit')\n","datamodule.setup('validate')\n","datamodule.setup('test')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VOZZYDsxhMmY","executionInfo":{"status":"ok","timestamp":1781187889959,"user_tz":-60,"elapsed":117787,"user":{"displayName":"Max","userId":"13369729728812710385"}},"outputId":"6be9813c-2925-44bf-a27e-f2e310f28bbd"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Data module downloaded\n"]}]},{"cell_type":"code","source":["datamodule.train_dataset.data = datamodule.train_dataset.data[\n","    : int(len(datamodule.train_dataset.data) * PCT_SAMPLES)\n","]\n","\n","datamodule.val_dataset.data = datamodule.val_dataset.data[\n","    : int(len(datamodule.val_dataset.data) * PCT_SAMPLES)\n","]\n","\n","datamodule.test_dataset.data = datamodule.test_dataset.data[\n","    : int(len(datamodule.test_dataset.data) * PCT_SAMPLES)\n","]\n","# be careful not to rerun this as it will shrink the datasets"],"metadata":{"id":"_1lcJqJaP9JE","executionInfo":{"status":"ok","timestamp":1781187889965,"user_tz":-60,"elapsed":3,"user":{"displayName":"Max","userId":"13369729728812710385"}}},"execution_count":15,"outputs":[]},{"cell_type":"code","source":["# Remove images with a False affected label\n","if REMOVE_UNAFFECTED:\n","  datamodule.train_dataset.data = [sample for sample in datamodule.train_dataset.data if int(sample['label']) == 1]\n","  datamodule.val_dataset.data = [sample for sample in datamodule.val_dataset.data if int(sample['label']) == 1]\n","  datamodule.test_dataset.data = [sample for sample in datamodule.test_dataset.data if int(sample['label']) == 1]"],"metadata":{"id":"3VCipu8bn7ia","executionInfo":{"status":"ok","timestamp":1781187889968,"user_tz":-60,"elapsed":1,"user":{"displayName":"Max","userId":"13369729728812710385"}}},"execution_count":16,"outputs":[]},{"cell_type":"code","source":["# PREPROCESSING\n","# Speckle filter?\n","# SAR-specific augmentation techniques\n","# Apparently for mag regression, flips, crops, and rotations are safe\n","\n","# Lee filter test\n","import matplotlib.pyplot as plt\n","\n","def VV_VH_2_RGB(sar_tensor):\n","    # 1. Convert to numpy if it's a PyTorch tensor\n","    if isinstance(sar_tensor, torch.Tensor):\n","        sar = sar_tensor.detach().cpu().numpy()\n","    else:\n","        sar = sar_tensor\n","\n","    # Ensure it's in (H, W, C) or handle (C, H, W)\n","    if sar.shape[0] == 2:\n","        vv = sar[0, :, :]\n","        vh = sar[1, :, :]\n","    else:\n","        vv = sar[:, :, 0]\n","        vh = sar[:, :, 1]\n","\n","    # 2. Convert raw amplitude/intensity to Decibels (dB)\n","    # Adding a tiny epsilon to avoid log(0)\n","    eps = 1e-6\n","    vv_db = 10 * np.log10(np.abs(vv) + eps)\n","    vh_db = 10 * np.log10(np.abs(vh) + eps)\n","    ratio_db = vv_db - vh_db # Division in linear scale becomes subtraction in dB\n","\n","    # 3. Clip and Normalize each channel to [0, 1]\n","    # SAR backscatter typically falls within specific ranges (e.g., -25 dB to 0 dB)\n","    def normalize(channel, vmin, vmax):\n","        channel = np.clip(channel, vmin, vmax)\n","        return (channel - vmin) / (vmax - vmin)\n","\n","    # Dynamic ranges vary, but these are solid baseline estimates for Sentinel-1:\n","    r = normalize(vv_db, vmin=-25, vmax=0)\n","    g = normalize(vh_db, vmin=-30, vmax=-5)\n","    b = normalize(ratio_db, vmin=0, vmax=15)\n","\n","    # 4. Stack into an RGB image layout (H, W, 3)\n","    rgb_image = np.stack([r, g, b], axis=-1)\n","\n","    return rgb_image\n","\n","def plot_dual_pol_sar(sar_tensor): # from gemini\n","    # 5. Plot it\n","    plt.figure(figsize=(8, 8))\n","    plt.imshow(rgb_image)\n","    plt.title(\"SAR Pseudo-RGB (R:VV, G:VH, B:VV/VH)\")\n","    plt.axis('off')\n","    plt.show()\n","\n","\n","from scipy.ndimage import uniform_filter\n","def LeeFilter(img_tensor, window_size: int = 5):\n","  \"\"\"Adapted from https://medium.com/@abhishekjainindore24/speckle-noise-and-ways-to-remove-it-01b1b15d074a\"\"\"\n","  img = img_tensor.numpy()\n","  # input is (4, 512, 512)\n","  size = (1, window_size, window_size)\n","  img_mean = uniform_filter(img, size)\n","  img_sqr_mean = uniform_filter(img**2, size)\n","  img_variance = img_sqr_mean - img_mean**2\n","\n","  overall_variance = np.var(img, axis=(1, 2), keepdims=True) # unsure about axis\n","\n","  img_weights = img_variance / (img_variance + overall_variance + 1e-8) # in case of div by 0\n","  img_output = img_mean + img_weights * (img - img_mean)\n","  return torch.from_numpy(img_output)\n","\n","\n","# sample = datamodule.train_dataset[0].copy()\n","# plot_dual_pol_sar(sample['image'][:2, :, :])\n","# sample['image'] = LeeFilter(sample['image'])\n","# plot_dual_pol_sar(sample['image'][:2, :, :]) #seems to dull it\n"],"metadata":{"id":"8wAXEjwfhWNu","executionInfo":{"status":"ok","timestamp":1781191286787,"user_tz":-60,"elapsed":4,"user":{"displayName":"Max","userId":"13369729728812710385"}}},"execution_count":46,"outputs":[]},{"cell_type":"code","source":["# Slicing post event images only\n","X_Train = [sample['image'][2:, :, :] for sample in datamodule.train_dataset] # dont filter in here or youll run out of RAM\n","Y_Train = [sample['magnitude'] for sample in datamodule.train_dataset]\n","X_Val = [sample['image'][2:, :, :] for sample in datamodule.val_dataset]\n","Y_Val = [sample['magnitude'] for sample in datamodule.val_dataset]\n","X_Test = [sample['image'][2:, :, :] for sample in datamodule.test_dataset]\n","Y_Test = [sample['magnitude'] for sample in datamodule.test_dataset]\n","\n","# Lee filter\n","X_Train_filtered = [LeeFilter(sample) for sample in X_Train]\n","X_Train_RGB = [VV_VH_2_RGB(sample) for sample in X_Train_filtered]\n","# X_Train_filtered = None\n","X_Val_filtered = [LeeFilter(sample) for sample in X_Val]\n","X_Val_RGB = [VV_VH_2_RGB(sample) for sample in X_Val_filtered]\n","# X_Val_filtered = None\n","\n","# Releasing memory\n","X_Train = None\n","X_Val = None\n","\n","def transposeQuakeSetSamples(samples): # needs to be transposed for keras training which wants channels last\n","  # Convert lists of PyTorch tensors to single NumPy arrays (NCHW format)\n","  samples_np = torch.stack(samples).numpy()\n","  # Transpose the input data from NCHW (Batch, Channels, Height, Width)\n","  # to NHWC (Batch, Height, Width, Channels) to match TensorFlow's preference.\n","  samples_np = samples_np.transpose(0, 2, 3, 1)\n","  return samples_np\n","\n","# X_Train_np = X_Train_filtered #transposeQuakeSetSamples(X_Train_filtered)\n","# X_Val_np = X_Val_filtered #transposeQuakeSetSamples(X_Val_filtered)\n","# X_Test_np = X_Test.copy() #transposeQuakeSetSamples(X_Test)\n","Y_Train_np = torch.stack(Y_Train).numpy() # need to be stacked as they are used in the model fitting\n","Y_Val_np = torch.stack(Y_Val).numpy()\n","\n","# Releasing more memory\n","Y_Train = None\n","Y_Val = None\n","X_Test = None\n","# Maybe get rid of datamodule?"],"metadata":{"id":"G04jmuumE7Qx","executionInfo":{"status":"ok","timestamp":1781192525163,"user_tz":-60,"elapsed":108174,"user":{"displayName":"Max","userId":"13369729728812710385"}}},"execution_count":56,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bf54b7a9","executionInfo":{"status":"ok","timestamp":1781194612928,"user_tz":-60,"elapsed":35267,"user":{"displayName":"Max","userId":"13369729728812710385"}},"outputId":"eefde076-710a-46b5-adc8-b4886