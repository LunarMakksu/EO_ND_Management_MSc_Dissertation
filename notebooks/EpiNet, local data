:[]},{"cell_type":"code","source":["# Remove images with a False affected label\n","if REMOVE_UNAFFECTED:\n","  datamodule.train_dataset.data = [sample for sample in datamodule.train_dataset.data if int(sample['label']) == 1]\n","  datamodule.val_dataset.data = [sample for sample in datamodule.val_dataset.data if int(sample['label']) == 1]\n","  datamodule.test_dataset.data = [sample for sample in datamodule.test_dataset.data if int(sample['label']) == 1]"],"metadata":{"id":"3VCipu8bn7ia"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#https://github.com/torchgeo/torchgeo/blob/main/torchgeo/datasets/quakeset.py\n"],"metadata":{"id":"E_zHcEOlwpDO","executionInfo":{"status":"ok","timestamp":1780999564999,"user_tz":-60,"elapsed":18,"user":{"displayName":"Max","userId":"13369729728812710385"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"d7fd4ac2-2c5a-4b9f-94dc-d95569527f9a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Empty DataFrame\n","Columns: []\n","Index: []\n"]}]},{"cell_type":"code","source":["# PREPROCESSING\n","# Speckle filter?\n","# SAR-specific augmentation techniques\n","# Apparently for mag regression, flips, crops, and rotations are safe\n","\n","# Lee filter test\n","import matplotlib.pyplot as plt\n","def plot_dual_pol_sar(sar_tensor): # from gemini\n","    # 1. Convert to numpy if it's a PyTorch tensor\n","    if isinstance(sar_tensor, torch.Tensor):\n","        sar = sar_tensor.detach().cpu().numpy()\n","    else:\n","        sar = sar_tensor\n","\n","    # Ensure it's in (H, W, C) or handle (C, H, W)\n","    if sar.shape[0] == 2:\n","        vv = sar[0, :, :]\n","        vh = sar[1, :, :]\n","    else:\n","        vv = sar[:, :, 0]\n","        vh = sar[:, :, 1]\n","\n","    # 2. Convert raw amplitude/intensity to Decibels (dB)\n","    # Adding a tiny epsilon to avoid log(0)\n","    eps = 1e-6\n","    vv_db = 10 * np.log10(np.abs(vv) + eps)\n","    vh_db = 10 * np.log10(np.abs(vh) + eps)\n","    ratio_db = vv_db - vh_db # Division in linear scale becomes subtraction in dB\n","\n","    # 3. Clip and Normalize each channel to [0, 1]\n","    # SAR backscatter typically falls within specific ranges (e.g., -25 dB to 0 dB)\n","    def normalize(channel, vmin, vmax):\n","        channel = np.clip(channel, vmin, vmax)\n","        return (channel - vmin) / (vmax - vmin)\n","\n","    # Dynamic ranges vary, but these are solid baseline estimates for Sentinel-1:\n","    r = normalize(vv_db, vmin=-25, vmax=0)\n","    g = normalize(vh_db, vmin=-30, vmax=-5)\n","    b = normalize(ratio_db, vmin=0, vmax=15)\n","\n","    # 4. Stack into an RGB image layout (H, W, 3)\n","    rgb_image = np.stack([r, g, b], axis=-1)\n","\n","    # 5. Plot it\n","    plt.figure(figsize=(8, 8))\n","    plt.imshow(rgb_image)\n","    plt.title(\"SAR Pseudo-RGB (R:VV, G:VH, B:VV/VH)\")\n","    plt.axis('off')\n","    plt.show()\n","\n","\n","from scipy.ndimage import uniform_filter\n","def LeeFilter(img_tensor, window_size: int = 5):\n","  \"\"\"Adapted from https://medium.com/@abhishekjainindore24/speckle-noise-and-ways-to-remove-it-01b1b15d074a\"\"\"\n","  img = img_tensor.numpy()\n","  # input is (4, 512, 512)\n","  size = (1, window_size, window_size)\n","  img_mean = uniform_filter(img, size)\n","  img_sqr_mean = uniform_filter(img**2, size)\n","  img_variance = img_sqr_mean - img_mean**2\n","\n","  overall_variance = np.var(img, axis=(1, 2), keepdims=True) # unsure about axis\n","\n","  img_weights = img_variance / (img_variance + overall_variance + 1e-8) # in case of div by 0\n","  img_output = img_mean + img_weights * (img - img_mean)\n","  return torch.from_numpy(img_output)\n","\n","\n","sample = datamodule.train_dataset[0].copy()\n","plot_dual_pol_sar(sample['image'][:2, :, :])\n","sample['image'] = LeeFilter(sample['image'])\n","plot_dual_pol_sar(sample['image'][:2, :, :]) #seems to dull it\n","\n"],"metadata":{"id":"8wAXEjwfhWNu"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["X_Train = [sample['image'] for sample in datamodule.train_dataset] # dont filter in here or youll run out of RAM\n","Y_Train_mag = [sample['magnitude'] for sample in datamodule.train_dataset]\n","X_Val = [sample['image'] for sample in datamodule.val_dataset]\n","Y_Val = [sample['magnitude'] for sample in datamodule.val_dataset]\n","X_Test = [sample['image'] for sample in datamodule.test_dataset]\n","Y_Test = [sample['magnitude'] for sample in datamodule.test_dataset]\n","\n","# Lee filter\n","X_Train_filtered = [LeeFilter(sample) for sample in X_Train]\n","X_Val_filtered = [LeeFilter(sample) for sample in X_Val]\n","\n","# Releasing memory\n","X_Train = None\n","X_Val = None\n","\n","def transposeQuakeSetSamples(samples):\n","  # Convert lists of PyTorch tensors to single NumPy arrays (NCHW format)\n","  samples_np = torch.stack(samples).numpy()\n","  # Transpose the input data from NCHW (Batch, Channels, Height, Width)\n","  # to NHWC (Batch, Height, Width, Channels) to match TensorFlow's preference.\n","  samples_np = samples_np.transpose(0, 2, 3, 1)\n","  return samples_np\n","\n","X_Train_np = transposeQuakeSetSamples(X_Train_filtered)\n","X_Val_np = transposeQuakeSetSamples(X_Val_filtered)\n","X_Test_np = transposeQuakeSetSamples(X_Test)\n","Y_Train_np = torch.stack(Y_Train).numpy() # need to be stacked as they are used in the model fitting\n","Y_Val_np = torch.stack(Y_Val).numpy()\n","\n","# Releasing more memory\n","Y_Train = None\n","Y_Val = None\n","X_Test = None\n","# Maybe get rid of datamodule?"],"metadata":{"id":"G04jmuumE7Qx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Custom network approach\n","from keras.models import Model, Sequential\n","from keras.layers import Input, Flatten, Dense, Conv2D, MaxPool2D, BatchNormalization, Dropout, Concatenate, Lambda # augmentation functions\n","from scipy.ndimage.filters import uniform_filter\n","from scipy.ndimage.measurements import variance\n","import torch # Ensure torch is imported if DEVICE relies on it\n","DEVICE = \"cuda\" if torch.cuda.is_available() else 'cpu'\n","\n","# [VV_pre, VH_pre, VV_post, VH_post]\n","input_shape = (512, 512, 4) # shape is (4, 512, 512) but it will have been be transposed\n","\n","main_input = Input(shape=input_shape, name=\"input\")\n","\n","# Split into pre and post images\n","pre_event_input = main_input[:, :, :, :2] #Lambda(lambda x: x[:, :, :, :2], output_shape=(512, 512, 2))(main_input)\n","post_event_input = main_input[:, :, :, 2:] #Lambda(lambda x: x[:, :, :, 2:], output_shape=(512, 512, 2))(main_input)\n","\n","# Feature extraction from pre event image - need emphasis on either?\n","pre_event = Conv2D(32, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event_input)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","pre_event = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","pre_event = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(pre_event)\n","pre_event = BatchNormalization()(pre_event)\n","pre_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(pre_event)\n","\n","# Feature extraction from post event image\n","post_event = Conv2D(32, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event_input)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","post_event = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","post_event = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(post_event)\n","post_event = BatchNormalization()(post_event)\n","post_event = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(post_event)\n","\n","# how to concatenate if the branches have different size outputs?\n","combined = Concatenate(axis=-1)([pre_event, post_event]) # on channel axis, could have different outputs, include affected label?\n","\n","# Learning shared features\n","x = Conv2D(64, kernel_size=(3, 3), activation='relu', padding=\"same\")(combined)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x) # this one was removed for better performance\n","x = Dropout(0.2)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Conv2D(128, kernel_size=(3, 3), activation='relu', padding=\"same\")(x)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x) # this one was removed for better performance\n","x = Dropout(0.2)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Conv2D(256, kernel_size=(3, 3), activation='relu', padding=\"same\")(x)#, padding='same', kernel_regularizer=regularizers.l2(l2_strength))(x)\n","x = BatchNormalization()(x)\n","x = Dropout(0.4)(x)\n","x = MaxPool2D(pool_size=(2, 2), strides=(2, 2))(x)\n","x = Flatten()(x)\n","mag_output = Dense(1, activation='linear', name=\"magnitude_output\")(x)\n","\n","model = Model(inputs=main_input, outputs=mag_output)\n","\n","model.summary()\n","from keras.utils import plot_model\n","try:\n","  plot_model(model, show_shapes=True, dpi=100)\n","except AssertionError as e:\n","  print(\"I think the input tensor split causes model plotting problems here\")"],"metadata":{"id":"lKbVmtDE-_qd"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from keras.optimizers import Adam\n","from keras.callbacks import EarlyStopping, ReduceLROnPlateau\n","\n","es_callback = EarlyStopping(monitor='val_loss',\n","                            # min_delta = 0.001,\n","                            patience=6,\n","                            restore_best_weights=True)\n","\n"