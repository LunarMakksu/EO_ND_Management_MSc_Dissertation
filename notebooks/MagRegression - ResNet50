est_val_mae\": best_val_mae,\n","    }, folder_models + model_name)\n","    model.eval()\n","\n","else:\n","  checkpoint = torch.load(folder_models + model_name, map_location=\"cpu\")\n","  model = resnet50(weights=ResNet50_Weights.SENTINEL1_ALL_MOCO, in_chans=2)\n","  in_features = model.fc.in_features\n","  model.fc = nn.Linear(in_features, 1)\n","  model = model.to(DEVICE)\n","  model.load_state_dict(checkpoint[\"model_state_dict\"])\n","\n","model.eval() # set to inference mode"]},{"cell_type":"code","source":["# # saving rfi data\n","# with h5py.File('/content/drive/My Drive/Dissertation/Datasets/local_quakeset_preprocessed_RFI.h5', 'w') as f:\n","#     f.create_dataset('X_Train', data=X_Train_preprocessed)\n","#     f.create_dataset('Y_Train', data=Y_Train_np)\n","#     f.create_dataset('X_Val', data=X_Val_preprocessed)\n","#     f.create_dataset('Y_Val', data=Y_Val_np)\n","#     f.close()\n"],"metadata":{"id":"XKWBHazeaaAz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["total_params = sum(\n","    p.numel()\n","    for p in model.parameters()\n",")\n","\n","trainable_params = sum(\n","    p.numel()\n","    for p in model.parameters()\n","    if p.requires_grad\n",")\n","\n","param_size = sum(\n","    p.numel() * p.element_size()\n","    for p in model.parameters()\n",")\n","\n","buffer_size = sum(\n","    b.numel() * b.element_size()\n","    for b in model.buffers()\n",")\n","\n","model_size_mb = (param_size + buffer_size) / (1024 ** 2)\n","\n","print(f\"Total parameters:     {total_params:,}\")\n","print(f\"Trainable parameters: {trainable_params:,}\")\n","print(f\"Model size:           {model_size_mb:.2f} MB\")"],"metadata":{"id":"e7E2Wqpbhkiz","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1787758285760,"user_tz":-60,"elapsed":11,"user":{"displayName":"Max","userId":"13369729728812710385"}},"outputId":"d7677e1d-8189-42b0-b398-ac922f2d2c5e"},"execution_count":null,"outputs":[{"output_type":"st