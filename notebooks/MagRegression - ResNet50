m \u001b[32m165.6/165.6 kB\u001b[0m \u001b[31m19.9 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m163.1/163.1 kB\u001b[0m \u001b[31m19.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m6.7/6.7 MB\u001b[0m \u001b[31m111.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m3.7/3.7 MB\u001b[0m \u001b[31m128.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m852.4/852.4 kB\u001b[0m \u001b[31m58.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m800.2/800.2 kB\u001b[0m \u001b[31m61.4 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h"]}],"source":["%pip install -q torchgeo h5py scikit-learn"]},{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":26522,"status":"ok","timestamp":1788098359614,"user":{"displayName":"Max","userId":"13369729728812710385"},"user_tz":-60},"id":"VOZZYDsxhMmY","outputId":"40e32678-242c-4624-d679-1e12c97fe9ec"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}],"source":["import h5py\n","import os\n","import time\n","import torch\n","import numpy as np\n","import tempfile\n","from collections import defaultdict\n","from pathlib import Path\n","from tqdm import tqdm\n","# from sklearn.model_selection import train_test_split\n","import shutil\n","from google.colab import drive\n","drive.mount('/content/drive') # for saving model\n","folder_models = ('/content/drive/My Drive/Dissertation/models/')\n","LOAD_LOCAL_QUAKESET = True\n"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"2eqKRJ5K95J_","executionInfo":{"status":"ok","timestamp":1788098209328,"user_tz":-60,"elapsed":20,"user":{"displayName":"Max","userId":"13369729728812710385"}}},"outputs":[],"source":["# Nabbed from sarpyx: https://github.com/ESA-PhiLab/sarpyx/blob/main/sarpyx/utils/rfigen.py\n","from scipy.constants import c\n","\n","def freq2wavelen(f_hz):\n","    return c / f_hz\n","\n","def fspl(r_m, wavelen_m):\n","    return (4 * np.pi * r_m / wavelen_m) ** 2\n","\n","def GenerateRFISignal(sqd, RadPar=None, verbose=False):\n","    \"\"\"Generate Radio Frequency Interference (RFI) signal for SAR data.\n","\n","    Args:\n","        sqd (np.ndarray): Input SAR single look complex data with shape (rows, cols).\n","        RadPar (dict): Radar parameters containing:\n","            - 'bw': Bandwidth in Hz\n","            - 'fo': Center frequency in Hz\n","            - 'fs': Sampling frequency in Hz\n","\n","    Returns:\n","        tuple: A tuple containing:\n","            - sInterf (np.ndarray): Generated interference signal with same shape as sqd\n","            - IR (dict): Dictionary containing RFI parameters used in generation\n","    \"\"\"\n","\n","\n","    if sqd is None:\n","        raise ValueError('The parameter \"sqd\" must be a valid numpy ndarray.')\n","\n","    if isinstance(sqd, torch.Tensor): # MB:added torch instance check for conversions\n","      sqd = sqd.cpu().numpy()\n","\n","    RadPar = {\n","            'fo': 5405000454.33435,\n","            'fs': 64345238.12571428,\n","            'bw': 56504455.48389234,\n","            'ts': 1.554116558005821e-08\n","    } if RadPar is None else RadPar\n","\n","\n","    IR = {}\n","\n","    # === RFI Physical Parameters ===\n","    IR['freqShift'] = (np.random.rand() - 0.5) * RadPar['bw']  # shift within radar BW\n","    IR['fc'] = RadPar['fo'] + IR['freqShift']\n","    IR['SIR_dB'] = np.random.uniform(-25, -5)  # control strength\n","    IR['bw'] = np.random.uniform(0.005, 0.05) * RadPar['bw']  # narrower than radar BW\n","    IR['PRF'] = np.random.randint(1000, 2000)\n","    IR['duty'] = np.random.uniform(0.1, 0.5)  # sparse duty\n","    IR['Gain'] = 1.0\n","    IR['Lambda'] = freq2wavelen(IR['fc'])\n","    IR['T'] = IR['duty'] / IR['PRF']\n","    IR['K'] = IR['bw'] / IR['T']\n","    fs = RadPar['fs']\n","    IR['t'] = np.arange(-IR['T']/2, IR['T']/2, 1/fs)\n","\n","    # === Chirp Pulse Generation ===\n","    chirp = np.exp(1j * np.pi * IR['K'] * IR['t']**2)\n","    chirp *= np.exp(1j * 2 * np.pi * IR['freqShift'] * IR['t'])  # center-shift\n","    chirp *= np.hanning(len(chirp))  # envelope\n","    chirp /= np.max(np.abs(chirp))\n","\n","    # === Pulse Train (1D) ===\n","    rows, cols = sqd.shape\n","    burst_duration = rows / IR['PRF']\n","    IRstream_len = int(burst_duration * fs)\n","    pulse_spacing = int(fs / IR['PRF'])\n","    pulse_len = len(chirp)\n","    IRstream = np.zeros(IRstream_len, dtype=np.complex64)\n","\n","    pulse_indices = np.arange(0, IRstream_len - pulse_len, pulse_spacing)\n","    N_total = len(pulse_indices)\n","    N_active = int(IR['duty'] * N_total)\n","    active_idx = np.random.choice(pulse_indices, N_active, replace=False)\n","    for idx in active_idx:\n","        IRstream[idx:idx+pulse_len] += chirp\n","\n","    # === Map to Burst Grid (Spatial Submask) ===\n","    IRmap = np.zeros((rows, cols), dtype=np.complex64)\n","    # Random RFI spatial extent (5-95% of image dimensions)\n","    az_fraction = np.random.uniform(0.05, 0.95)\n","    rg_fraction = np.random.uniform(0.05, 0.95)\n","    sub_rows = int(rows * az_fraction)\n","    sub_cols = int(cols * rg_fraction)\n","\n","    # Random position ensuring no border overflow\n","    az_start = np.random.randint(0, max(1, rows - sub_rows + 1))\n","    az_stop = az_start + sub_rows\n","    rg_start = np.random.randint(0, max(1, cols - sub_cols + 1))\n","    rg_stop = rg_start + sub_cols\n","\n","    # reshape with tiling\n","    IRstream_crop = IRstream[:sub_rows * sub_cols]\n","    IRmap[az_start:az_stop, rg_start:rg_stop] = IRstream_crop.reshape((sub_rows, sub_cols))\n","\n","    # === Power Calibration ===\n","    signal_power_lin = np.mean(np.abs(sqd)**2)\n","    signal_power_dB = 10 * np.log10(signal_power_lin + 1e-6) # MB: added 1e-6 to prevent div 0\n","    PrRFI_dB = signal_power_dB - IR['SIR_dB']\n","    PrRFI = 10 ** (PrRFI_dB / 10)\n","    sInterf = IRmap * np.sqrt(PrRFI)\n","\n","    # === Metadata & Logging ===\n","    IR['AffectedAz'] = (az_start, az_stop)\n","    IR['AffectedRg'] = (rg_start, rg_stop)\n","    if verbose:\n","        print(f\"[INFO] Injected RFI: freq offset = {IR['freqShift']/1e6:.2f} MHz, bw = {IR['bw']/1e6:.2f} MHz\")\n","        print(f\"[INFO] SIR = {IR['SIR_dB']} dB, Affected area: Az[{az_start}:{az_stop}], Rg[{rg_start}:{rg_stop}]\")\n","\n","    return sInterf, IR\n","\n","# sample = datamodule.train_dataset[0]['image'][2:, :, :]\n","# sample = 10.0 * torch.log10(sample + 1e-6)\n","# img = plot_dual_pol_sar(sample)\n","# # plt.imsave(\"/content/drive/My Drive/Dissertation/sample_rgb.png\", img)\n","# signal_VV, IR_dict_VV = GenerateRFISignal(sample[0, :, :], verbose=True)\n","# signal_VH, IR_dict_VH = GenerateRFISignal(sample[1, :, :], verbose=True)\n","# sample[0] = sample[0, :, :] + torch.from_numpy(signal_VV)\n","# sample[1] = sample[1, :, :] + torch.from_numpy(signal_VH)\n","# img = plot_dual_pol_sar(sample)\n","# plt.imsave(\"/content/drive/My Drive/Dissertation/sample_rgb_RFI.png\", img)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8wAXEjwfhWNu"},"outputs":[],"source":["# Preprocessing functions\n","# Speckle filter - LeeFilter\n","# Preprocessing of (2, 512, 512) image tensor - preprocess_dual_pol_SAR\n","# Transpose samples for keras preferred format - transposeQuakeSetSamples\n","# Convert to pseudo RGB format and plot VV, VH tensors - plot_dual_pol_sar\n","\n","import matplotlib.pyplot as plt\n","def plot_dual_pol_sar(sar_tensor): # from gemini, can be used for visualizing noise too probably\n","    # 1. Convert to numpy if it's a PyTorch tensor\n","    if isinstance(sar_tensor, torch.Tensor):\n","        sar = sar_tensor.detach().cpu().numpy()\n","    else:\n","        sar = sar_tensor\n","\n","    # Ensure it's in (H, W, C) or handle (C, H, W)\n","    if sar.shape[0] == 2:\n","        vv = sar[0, :, :]\n","        vh = sar[1, :, :]\n","    else:\n","        vv = sar[:, :, 0]\n","        vh = sar[:, :, 1]\n","\n","    # 2. Convert raw amplitude/intensity to Decibels (dB)\n","    # Adding a tiny epsilon to avoid log(0)\n","    eps = 1e-6\n","    vv_db = 10 * np.log10(np.abs(vv) + eps)\n","    vh_db = 10 * np.log10(np.abs(vh) + eps)\n","    ratio_db = vv_db - vh_db # Division in linear scale becomes subtraction in dB\n","\n","    # 3. Clip and Normalize each channel to [0, 1]\n","    # SAR backscatter typically falls within specific ranges (e.g., -25 dB to 0 dB)\n","    def normalize(channel, vmin, vmax):\n","        channel = np.clip(channel, vmin, vmax)\n","        return (channel - vmin) / (vmax - vmin)\n","\n","    # Dynamic ranges vary, but these are solid baseline estimates for Sentinel-1:\n","    r = normalize(vv_db, vmin=-25, vmax=0)\n","    g = normalize(vh_db, vmin=-30, vmax=-5)\n","    b = normalize(ratio_db, vmin=0, vmax=15)\n","\n","    # 4. Stack into an RGB image layout (H, W, 3)\n","    rgb_image = np.stack([r, g, b], axis=-1)\n","\n","    # 5. Plot it\n","    plt.figure(figsize=(8, 8))\n","    plt.imshow(rgb_image)\n","    plt.title(\"SAR Pseudo-RGB (R:VV, G:VH, B:VV/VH)\")\n","    plt.axis('off')\n","    plt.show()\n","    return rgb_image\n","\n","raw2power = lambda t: 10.0 * torch.log10(t + 1e-6)\n","power2raw = lambda t: 10.0 ** (t / 10.0) - 1e-6\n","\n","from scipy.ndimage import uniform_filter\n","def LeeFilter(img_tensor, window_size: int = 5, noise_variance: float = 0.05): #increase strength with higher nv, was 0.05\n","    img = img_tensor.numpy()\n","    size = (1, window_size, window_size)\n","\n","    # 1. Compute local statistics\n","    img_mean = uniform_filter(img, size)\n","    img_sqr_mean = uniform_filter(img**2, size)\n","    img_variance = img_sqr_mean - img_mean**2\n","\n","    # 2. True Lee Filter Weighting Formula\n","    # k = Var(x) / Var(y) where Var(x) = (Var(y) - mean^2 * noise_var) / (1 + noise_var)\n","    # To keep it safe from negatives, we clip at 0\n","    img_true_var = (img_variance - (img_mean**2) * noise_variance) / (1 + noise_variance)\n","    img_true_var = np.clip(img_true_var, 0, None)\n","\n","    img_weights = img_true_var / (img_variance + 1e-8)\n","\n","    # 3. Linear combination\n","    img_output = img_mean + img_weights * (img - img_mean)\n","    return torch.from_numpy(img_output)\n","\n","def calc_subset_mean_std(subset_of_tensors):\n","  all_means = []\n","  all_stds = []\n","\n","  for sample in subset_of_tensors:\n","    all_means.append(torch.mean(sample))\n","    all_stds.append(torch.std(sample))\n","\n","  global_mu = float(torch.stack(all_means).mean(dim=0))\n","  global_std = float(torch.stack(all_stds).mean(dim=0))\n","  return global_mu, global_std\n","\n","def preprocess_dual_pol_SAR_subset(subset_of_tensors, mu=None, std=None, apply_noise=False): #db conversion and clamping and z-score per channel\n","  #Convert to dB scale\n","  input_length = len(subset_of_tensors)\n","  for i, tensor in enumerate(tqdm(subset_of_tensors, desc=\"preprocessing\", disable=(input_length <= 1))):\n","    if apply_noise:\n","      if i <= int(np.floor(input_length / 4)):\n","        tensor_VV_max = torch.max(tensor[0])\n","        tensor_VV_min = torch.min(tensor[0])\n","        tensor_VH_max = torch.max(tensor[1])\n","        tensor_VH_min = torch.min(tensor[1])\n","        signal_VV, _ = GenerateRFISignal(tensor[0, :, :])\n","        signal_VH, _ = GenerateRFISignal(tensor[1, :, :])\n","        tensor[0] = tensor[0, :, :] + torch.from_numpy(signal_VV)\n","        tensor[1] = tensor[1, :, :] + torch.from_numpy(signal_VH)\n","        # clamp to original maximum\n","        tensor[0] = torch.clamp(tensor[0], tensor_VV_min, tensor_VV_max)\n","        tensor[1] = torch.clamp(tensor[1], tensor_VH_min, tensor_VH_max)\n","    tensor = LeeFilter(tensor)\n","    # plot_dual_pol_sar(tensor)\n","    tensor = raw2power(tensor)\n","\n","    # Clip dB outliers\n","    # idx 0 is VV, 1 is VH\n","    tensor[0] = torch.clamp(tensor[0], -30.0, 0.0)\n","    tensor[1] = torch.clamp(tensor[1], -60, 0.0) #VH a lot more dynamic\n","    subset_of_tensors[i] = tensor\n","\n","  # Channel wise means and stds\n","  if [mu, std] == [None, None]:\n","    mu, std = calc_subset_mean_std(subset_of_tensors)\n","  subset_of_tensors = [(tensor - mu) / (std + 1e-6) for tensor in subset_of_tensors]\n","  return subset_of_tensors, mu, std\n","\n","\n","def transposeQuakeSetSamples(samples):\n","  samples_np = torch.stack(samples).numpy()\n","  # Transpose the input data from (Batch, Channels, Height, Width) to (Batch, Height, Width, Channels) for TensorFlow's preference.\n","  samples_np = samples_np.transpose(0, 2, 3, 1)\n","  return samples_np\n","\n","# Testing the funcs\n","# sample = datamodule.train_dataset[2]['image'][2:, :, :].clone()\n","# img = plot_dual_pol_sar(sample)\n","# plt.imsave(\"/content/drive/My Drive/Dissertation/sample_rgb_2.png\", img)\n","# sample = LeeFilter(sample)\n","# img = plot_dual_pol_sar(sample)\n","# plt.imsave(\"/content/drive/My Drive/Dissertation/sample_rgb_2_leefilter.png\", img)\n","# sample['image'] = LeeFilter(sample['image'])\n","# plot_dual_pol_sar(sample['image'][:2, :, :]) #seems to dull it\n","# sample_dB = raw2power(sample)\n","# plt.figure(figsize=(8, 8))\n","# plt.scatter(sample_dB[0], sample_dB[1], s=5)\n","# plt.xlabel('VV (dB)')\n","# plt.ylabel('VH (dB)')\n","# plt.title('Raw sample')\n","\n","# pp_sample, _, _ = preprocess_dual_pol_SAR_subset([sample], mu=torch.mean(sample), std=torch.std(sample), apply_noise=True, noise_lo=0.8, noise_hi=1.2, use_RFI=True)\n","# pp_sample = pp_sample[0]\n","# plt.figure(figsize=(8, 8))\n","